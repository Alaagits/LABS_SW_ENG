<?xml version="1.0" encoding="UTF-8"?>

<!-- Welcome screen. Controller: WelcomeController fills welcomeLabel. -->

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>

<StackPane prefHeight="300.0" prefWidth="400.0"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="WelcomeController">
   <children>
      <!-- StackPane keeps the label centered when the window is resized. -->
      <Label fx:id="welcomeLabel" style="-fx-font-size: 18px;" text="Welcome" />
   </children>
</StackPane>